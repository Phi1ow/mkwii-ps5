diff --git a/tools/SharpProspero.Link/EhFrame.cs b/tools/SharpProspero.Link/EhFrame.cs
index 83e0e06..21672c7 100644
--- a/tools/SharpProspero.Link/EhFrame.cs
+++ b/tools/SharpProspero.Link/EhFrame.cs
@@ -16,6 +16,46 @@ namespace SharpProspero.Link;
 /// <summary>Reads the exception frames and builds their search index.</summary>
 internal static class EhFrame
 {
+    // A non-grouped frame section can still describe discarded COMDAT code.
+    // Its FDE must go with that code: remapping it onto the kept function can
+    // associate that function with a different stack layout or LSDA. Keep byte
+    // offsets stable by replacing the discarded FDE with an unreferenced valid
+    // CIE padded with DW_CFA_nop, and skip all relocations inside that record.
+    internal static (byte[] Data, HashSet<ulong> IgnoredRelocations) PruneDiscarded(
+        ElfObject obj, int section, IReadOnlySet<(ElfObject Object, int Section)> dropped)
+    {
+        byte[] data = (byte[])obj.Sections[section].Data.Clone();
+        var ignored = new HashSet<ulong>();
+        if (!obj.Relocations.TryGetValue(section, out var relocs)) return (data, ignored);
+        for (int pos = 0; pos + 4 <= data.Length;)
+        {
+            uint length = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(pos));
+            if (length == 0) break;
+            if (length < 4 || length > data.Length - pos - 4)
+                throw new ElfLinkException($"{obj.Origin}: malformed .eh_frame record at {pos}.");
+            int end = pos + 4 + (int)length;
+            uint id = BinaryPrimitives.ReadUInt32LittleEndian(data.AsSpan(pos + 4));
+            bool discard = false;
+            if (id != 0)
+                foreach (var r in relocs)
+                    if (r.Offset == (ulong)(pos + 8) && r.SymbolIndex < obj.Symbols.Count &&
+                        dropped.Contains((obj, obj.Symbols[(int)r.SymbolIndex].SectionIndex)))
+                        discard = true;
+            if (discard)
+            {
+                if (length < 13)
+                    throw new ElfLinkException($"{obj.Origin}: discarded FDE is too short to neutralize.");
+                data.AsSpan(pos + 4, (int)length).Clear();
+                new byte[] { 1, (byte)'z', (byte)'R', 0, 1, 0x78, 16, 1, 0x1b }
+                    .CopyTo(data, pos + 8);
+                foreach (var r in relocs)
+                    if (r.Offset >= (ulong)pos && r.Offset < (ulong)end) ignored.Add(r.Offset);
+            }
+            pos = end;
+        }
+        return (data, ignored);
+    }
+
     // Pointer-encoding nibbles.
     private const byte FormatMask = 0x0F, ApplicationMask = 0x70;
     private const byte AbsPtr = 0x00, UData4 = 0x03, UData8 = 0x04, SData4 = 0x0B, SData8 = 0x0C;
