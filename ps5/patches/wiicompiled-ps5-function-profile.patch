+#if defined(MKW_PLATFORM_PS5) && defined(MKW_PS5_FPROF)
+// DIAGNOSTIC, profiling build variant only (ps5/runtime/function_profiler_ps5.cpp):
+// count every cold scalar access by kind and by whether its 1 MiB page is
+// covered by a pending deferred read, time one call in 16, and histogram the
+// coarse pages. Plain counters: the guest thread is the only hot caller.
+#include <x86intrin.h>
+struct MkwSlowAccessCounters {
+    uint64_t calls[13][2];
+    uint64_t sampledTicks[13];
+    uint64_t sampled[13];
+    uint32_t pages[MemoryInline::kPageCount];
+};
+static MkwSlowAccessCounters g_mkwSlowAccess{};
+extern "C" MkwSlowAccessCounters* mkw_fprof_memory_counters() { return &g_mkwSlowAccess; }
+namespace {
+struct MkwSlowAccessScope {
+    unsigned kind;
+    uint64_t start = 0;
+    MkwSlowAccessScope(unsigned k, uint32_t addr) noexcept : kind(k) {
+        const unsigned covered = MemoryInline::g_deferredReadCoveredPages[addr >> MemoryInline::kPageShift] ? 1u : 0u;
+        const uint64_t n = ++g_mkwSlowAccess.calls[k][covered];
+        ++g_mkwSlowAccess.pages[addr >> MemoryInline::kPageShift];
+        if ((n & 15u) == 0) start = __rdtsc();
+    }
+    ~MkwSlowAccessScope() {
+        if (!start) return;
+        g_mkwSlowAccess.sampledTicks[kind] += __rdtsc() - start;
+        ++g_mkwSlowAccess.sampled[kind];
+    }
+};
+}  // namespace
