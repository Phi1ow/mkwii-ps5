+MKW_MEMORY_FORCE_INLINE const uint8_t* TryGetReadableScalarHost(uint32_t address) {
+    const uint32_t page = address >> kPageShift;
+    uintptr_t encodedBias = g_fullReadablePageBias[page];
+    if (encodedBias == 0) [[unlikely]] {
+#if defined(MKW_PLATFORM_PS5)
+        // A pending deferred read zeroes the readable bias of its whole 1 MiB
+        // page; only the 4 KiB pages it marks need the cold path.
+        if (!g_deferredReadCoveredPages[page] || g_deferredReadCoveredSubPages[address >> kDeferredSubPageShift])
+            return nullptr;
