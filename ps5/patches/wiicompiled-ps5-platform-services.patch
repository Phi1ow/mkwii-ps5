+#if defined(MKW_PLATFORM_PS5)
+	return 1000000000;
+#elif defined(CRYPTOPP_WIN32_AVAILABLE) && defined(THREAD_TIMER_AVAILABLE)
 	return 10*1000*1000;
 #elif defined(CRYPTOPP_WIN32_AVAILABLE) && !defined(THREAD_TIMER_AVAILABLE)
