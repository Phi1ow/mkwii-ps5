+uint64_t Memory::RegisterDeferredRamRead(uint32_t addr, size_t length,
+                                         DeferredReadCallback callback,
+                                         std::shared_ptr<void> user) {
+    if (!length || !callback || !user) return 0;
+    const uint32_t window = addr & 0xc0000000u;
+    if (window != 0 && window != 0x80000000u && window != 0xc0000000u) return 0;
+    const uint32_t physical = addr & 0x3fffffffu;
+    const bool mem1 = physical < kMem1Size;
+    const bool mem2 = physical >= kMem2PhysicalBase && physical < kMem2PhysicalEnd;
+    if (!mem1 && !mem2) return 0;
+    const uint64_t end = mem1 ? kMem1Size : kMem2PhysicalEnd;
+    if (length > end - physical) return 0;
+    auto read = std::make_shared<DeferredRead>();
+    read->rangeCount = 3;
+    read->ranges = {{{physical, length}, {physical | 0x80000000u, length},
+                     {physical | 0xc0000000u, length}}};
+    // Only accept actual coherent RAM aliases, including custom test layouts.
+    uint8_t* host = nullptr;
+    for (const auto& range : read->ranges) {
+        if (!Contains(range.start, length)) return 0;
+        auto* pointer = GetPointer(range.start, length);
+        if (host && pointer != host) return 0;
+        host = pointer;
+    }
+    read->callback = callback;
+    read->user = user.get();
+    read->owner = std::move(user);
+    return InsertDeferredRead(read);
