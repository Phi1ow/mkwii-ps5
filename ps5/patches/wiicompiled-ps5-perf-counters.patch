+// PS5 performance accounting: host time the guest scheduler spends with no
+// runnable guest thread, and the part of it spent sleeping until the next VI
+// retrace. Read by the frame statistics in ps5/gpu/gx_frame_renderer.cpp.
+namespace {
+std::atomic<uint64_t> g_mkwGuestIdleNanos{0};
+std::atomic<uint64_t> g_mkwGuestIdleSleepNanos{0};
+inline uint64_t mkw_idle_clock() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+}
+extern "C" uint64_t mkw_guest_idle_nanos() { return g_mkwGuestIdleNanos.load(std::memory_order_relaxed); }
+extern "C" uint64_t mkw_guest_idle_sleep_nanos() { return g_mkwGuestIdleSleepNanos.load(std::memory_order_relaxed); }
+#endif
