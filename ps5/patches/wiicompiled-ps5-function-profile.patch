+#define MKW_SLOW_WRITE(kind, addr) MkwSlowAccessScope mkwSlowAccess(IsGpuFifoAddress(addr) ? 12u : (kind), (addr))
+#else
+#define MKW_SLOW_ACCESS(kind, addr)
+#define MKW_SLOW_WRITE(kind, addr)
