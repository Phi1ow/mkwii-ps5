@@ -149,6 +152,31 @@ inline bool Ensure(const std::filesystem::path& root, std::string& error,
                    std::time_t now = std::time(nullptr)) {
     const auto path = FilePath(root);
     std::error_code ec;
+#if defined(MKW_PLATFORM_PS5)
+    // Applications have rename but no link/linkat export. Serialize every PS5
+    // reader/publisher through a directory claim before checking the target.
+    // Rename then publishes the complete file atomically for cooperating game
+    // instances. External writers must not modify this NAND while it is open.
+    // Never break a stale claim automatically: it may belong to a live writer.
+    std::filesystem::create_directories(path.parent_path(), ec);
+    if (ec) { error = "Cannot create NAND settings directory: " + ec.message(); return false; }
+    struct PublishLock {
+        std::filesystem::path path;
+        bool owned = false;
+        ~PublishLock() { if (owned) { std::error_code ignored; std::filesystem::remove(path, ignored); } }
+    } lock{path.parent_path() / ".setting-publish-lock"};
+    for (unsigned attempt = 0; attempt < 100; ++attempt) {
+        ec.clear();
+        if (std::filesystem::create_directory(lock.path, ec)) { lock.owned = true; break; }
+        if (ec && ec != std::errc::file_exists) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    if (!lock.owned) {
+        error = "NAND setting.txt publication is locked or unavailable; existing data was left untouched";
+        return false;
+    }
+    ec.clear();
+#endif
     const auto status = std::filesystem::symlink_status(path, ec);
