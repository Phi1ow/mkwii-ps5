 TimerWord ThreadUserTimer::GetCurrentTimerValue()
 {
-#if defined(CRYPTOPP_WIN32_AVAILABLE) && defined(THREAD_TIMER_AVAILABLE)
+#if defined(MKW_PLATFORM_PS5)
+	// Native clock 14 measures this thread's CPU time, excluding sleep and
+	// other threads (PPSA99599). It includes kernel time, as clock() does on
+	// some existing backends; it is not a user-only accounting interface.
+	timespec now = {};
