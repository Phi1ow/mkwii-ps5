+// Registers (+1) or retires (-1) the 4 KiB page marks of a deferred read, with
+// the same [start - 7, end) extent as the 1 MiB pages above. Called under the
+// registry mutex whenever the read enters or leaves DeferredReads().
+void AdjustDeferredReadSubPages(const DeferredRead& read, int delta) {
+    for (size_t i = 0; i < read.rangeCount; ++i) {
+        const auto& range = read.ranges[i];
+        const uint32_t first = (range.start >= 7 ? range.start - 7 : 0) >> MemoryInline::kDeferredSubPageShift;
+        const uint32_t last = static_cast<uint32_t>(
+            (uint64_t(range.start) + range.length - 1) >> MemoryInline::kDeferredSubPageShift);
+        for (uint32_t subPage = first; subPage <= last; ++subPage)
+            MemoryInline::g_deferredReadCoveredSubPages[subPage] =
+                static_cast<uint16_t>(MemoryInline::g_deferredReadCoveredSubPages[subPage] + delta);
+    }
+}
