diff --git a/runtime/src/settings_overlay.cpp b/runtime/src/settings_overlay.cpp
index 9354800..f623d06 100644
--- a/runtime/src/settings_overlay.cpp
+++ b/runtime/src/settings_overlay.cpp
@@ -1354,6 +1354,9 @@ void HandleEvents(const AuroraEvent* events) noexcept {
         if (ev->type != AURORA_SDL_EVENT) {
             continue;
         }
+#if defined(MKW_PLATFORM_PS5)
